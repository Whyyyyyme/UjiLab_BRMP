# ==============================================================================
# SILAB BIOGEN - KONFIGURASI ENVIRONMENT PRODUKSI (PRODUCTION)
# Balai Besar Pengujian Standar Instrumen Bioteknologi dan Sumberdaya Genetik Pertanian
# Kementerian Pertanian Republik Indonesia
# ==============================================================================

# --- IDENTITAS & KEAMANAN APLIKASI ---
APP_NAME="SILAB Biogen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ujilab.brmp.go.id
FRONTEND_URL=https://ujilab.brmp.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# --- LOGGING SISTEM ---
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- PANGKALAN DATA (DATABASE PRODUKSI: MYSQL / MARIADB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ujilab_biogen
DB_USERNAME=ujilab_dbuser
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuatDanUnik

# --- SESI PENGGUNA (SESSION HARDENING) ---
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --- PENYIMPANAN BERKAS (FILESYSTEM PRIVATE) ---
# Dokumen PDF laporan hasil uji disimpan di direktori lokal privat non-public
FILESYSTEM_DISK=local

# --- ANTREAN TUGAS LATAR BELAKANG (QUEUE WORKER) ---
# Gunakan driver database agar pengiriman email tidak menahan proses simpan petugas
QUEUE_CONNECTION=database

# --- CACHE & PEMELIHARAAN ---
CACHE_STORE=database
APP_MAINTENANCE_DRIVER=file

# --- PENGIRIMAN EMAIL NOTIFIKASI (SMTP RESMI INSTANSI) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email-resmi@brmp.go.id
MAIL_PASSWORD=app-password-smtp-anda
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="layanan-lab@brmp.go.id"
MAIL_FROM_NAME="Layanan Uji Lab BRMP Biogen"

# --- GOOGLE GEMINI AI (OCR EKSTRAKSI PDF) ---
# Masukkan API Key Gemini untuk ekstraksi otomatis form upload berkas PDF
GEMINI_API_KEY=
